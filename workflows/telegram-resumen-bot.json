    {
      "parameters": {
        "jsCode": "const text = $json.message.text || \"\";\nconst chat_id = $json.message.chat.id;\nconst message_id = $json.message.message_id;\n\n// Buscamos un enlace en el texto usando regex\nconst urlMatch = text.match(/(https?:\\/\\/[^\\s]+)|(www\\.[^\\s]+)/);\nconst url = urlMatch ? urlMatch[0] : null;\n\n// Si no hay enlace (ej: \"hola\"), devolvemos acción de saludo\nif (!url) {\n  return [{ json: { accion: 'saludo', chat_id } }];\n}\n\n// Si hay enlace, devolvemos acción de preguntar idioma y guardamos el message_id\nreturn [{ json: { accion: 'preguntar_idioma', url, chat_id, message_id } }];"
      },
      "type": "n8n-nodes-base.code",
