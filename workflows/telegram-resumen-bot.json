    {
      "parameters": {
        "jsCode": "// Leemos directamente del Trigger para evitar que Confirmar callback lo sobrescriba\nconst cb = $('Telegram Trigger').item.json.callback_query;\n\nif (!cb || !cb.message) {\n  throw new Error(\"No se recibió el mensaje del callback desde el Trigger.\");\n}\n\nconst chat_id = cb.message.chat.id;\nconst lang = cb.data.replace('lang_', ''); \n\n// Buscamos la URL del mensaje al que se le hizo reply\nlet url = \"\";\nif (cb.message.reply_to_message && cb.message.reply_to_message.text) {\n  url = cb.message.reply_to_message.text;\n} else if (cb.message.text) {\n  url = cb.message.text; \n}\n\nif (!url || !url.includes(\"http\")) {\n  throw new Error(\"No se encontró la URL original.\");\n}\n\nconst isYoutube = url.includes(\"youtube.com\") || url.includes(\"youtu.be\");\nconst tipo = isYoutube ? 'opcion_youtube' : 'opcion_web';\n\nreturn [{ json: { url, chat_id, tipo, lang } }];"
      },
