    {
      "parameters": {
        "jsCode": "// Recogemos el texto que generó la IA\nlet texto = $json.output;\n\n// Quitamos todos los asteriscos que puedan romper Telegram\ntexto = texto.replace(/\\*/g, ''); \n// Quitamos los guiones bajos de negrita/cursiva\ntexto = texto.replace(/_/g, ' ');\n\n// Devolvemos el JSON con el campo \"texto_limpio\" que espera el nodo de Telegram\nreturn [{\n  json: {\n    texto_limpio: texto\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
