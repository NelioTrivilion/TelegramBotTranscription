    {
      "parameters": {
        "jsCode": "// Sacamos la URL original\nconst url = $('Resolver idioma').item.json.url;\n\n// Regex que captura el ID de cualquier formato de YouTube\nconst match = url.match(/(?:youtu\\.be\\/|youtube\\.com\\/(?:embed\\/|v\\/|watch\\?v=|watch\\?.+&v=|shorts\\/))([\\w-]{11})/);\n\nif (match && match[1]) {\n  return [{ json: { video_id: match[1] } }];\n} else {\n  throw new Error(\"No pude encontrar un ID de video válido en esta URL: \" + url);\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        -112
      ],
      "id": "aac828fe-0bee-41f7-8d74-595732ca0ec7",
      "name": "Extraer video ID"
    },
    {
      "parameters": {
        "jsCode": "let texto = \"\";\nlet rawData = $json.data || $json;\n\n// Si Supadata nos devuelve un texto que parece JSON\nif (typeof rawData === 'string') {\n  try {\n    const parsed = JSON.parse(rawData);\n    texto = parsed.content || parsed.text || rawData;\n  } catch (e) {\n    texto = rawData;\n  }\n} else {\n  texto = rawData.content || rawData.text || JSON.stringify(rawData);\n}\n\n// Si el texto es muy corto, fallback\nif (!texto || texto.length < 50) {\n  texto = \"No se pudo extraer la transcripción del video.\";\n}\n\n// Limitamos a 25.000 caracteres para no exceder el contexto del modelo\ntexto = texto.substring(0, 25000);\n\n// Devolvemos un objeto normalizado para el resto del pipeline\nreturn [{\n  json: {\n    texto: texto,\n    url: $('Resolver idioma').item.json.url,\n    chat_id: $('Resolver idioma').item.json.chat_id,\n    tipo: $('Resolver idioma').item.json.tipo\n  }\n}];"
      },
